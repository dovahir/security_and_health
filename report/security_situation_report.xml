<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="report_final_document">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="web.external_layout">
                        <div class="page" style="padding: 5mm; font-family: 'DejaVu Sans', sans-serif; font-size: 10pt; line-height: 1.2;">

                            <!-- HEADER (sobreescribe el default) -->
                            <div class="header" style="height: 30mm; padding: 5mm; text-align: center; border-bottom: 2px solid #2c3e50;">
                                <h2 style="margin: 0; color: #2c3e50; font-size: 14pt;">REPORTE DE SEGURIDAD</h2>
                                <h3 style="margin: 0; color: #e74c3c; font-size: 12pt;">
                                    <span t-field="o.security_situation_id.name"/> <!-- referencia -->
                                </h3>
                                <div style="font-size: 8pt; color: #666; margin-top: 2mm;">
                                    Fecha de emisión: <span t-field="o.create_date" t-options='{"widget": "date"}'/>
                                </div>
                            </div>

                            <!-- FOOTER (sobreescribe el default) -->
                            <div class="footer" style="height: 15mm; padding: 3mm; text-align: center; border-top: 1px solid #ccc; font-size: 7pt; color: #7f8c8d;">
                                <div>
                                    Página <span class="page"/> de <span class="topage"/>
                                </div>
                            </div>

                            <!-- CONTENIDO PRINCIPAL -->
                            <div style="margin-bottom: 3mm; border-top: 1px solid #3498db; padding-top: 2mm;">
                                <div style="background: #3498db; color: #f8f9fa; padding: 1mm 2mm; font-size: 10pt; margin-bottom: 1mm;">
                                    <strong>DETALLES DE SITUACIÓN</strong>
                                </div>

                                <!-- DATOS EN GRID -->
                                <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1mm; margin-bottom: 1mm;">
                                    <div>
                                        <strong>Fecha y hora del Evento:</strong><br/>
                                        <span t-field="o.security_situation_id.event_date" t-options='{"widget": "datetime"}'/>
                                    </div>
                                    <!-- CAMPO INLINE CON CONDICIONAL -->
                                    <div>
                                        <span style="display: inline-block; margin-right: 5mm;">
                                            <strong>Tipo de Situación:</strong><br/>
                                            <span t-field="o.security_situation_id.type"/>
                                        </span>
                                        <t t-if="o.security_situation_id.type == 'restricted_work_case'">
                                            <span style="display: inline-block; margin-right: 5mm;">
                                                <strong>Días Restringidos:</strong> <span t-field="o.security_situation_id.rwc_days"/>
                                            </span>
                                        </t>
                                    </div>

                                    <div>
                                        <span style="display: inline-block; margin-right: 15mm;">
                                            <strong>Tipo de Actividad:</strong><br/>
                                            <span t-field="o.security_situation_id.activities_type_id"/>
                                        </span>
                                        <span style="display: inline-block; margin-right: 15mm;">
                                            <strong>Causa:</strong><br/>
                                            <span t-field="o.security_situation_id.cause"/>
                                        </span>
                                        <span style="display: inline-block;">
                                            <strong>Severidad del evento:</strong><br/>
                                            <span t-field="o.security_situation_id.event_severity"/>
                                        </span>
                                    </div>

                                    <div>
                                        <strong>Medidas inmediatas</strong><br/>
                                        <span t-field="o.security_situation_id.immediate_actions"/>
                                    </div>

                                    <div>
                                        <span style="display: inline-block; margin-right: 20mm;">
                                            <strong>Empresa:</strong><br/>
                                            <span t-field="o.security_situation_id.company_id.name"/>
                                        </span>
                                        <span style="display: inline-block; margin-right: 15mm;">
                                            <strong>Ubicación de Trabajo:</strong><br/>
                                            <span t-field="o.security_situation_id.work_center_id.name"/>
                                        </span>
                                        <span style="display: inline-block;">
                                            <strong>Área/Lugar Exacto:</strong><br/>
                                            <span t-field="o.security_situation_id.work_area_id.name"/>
                                        </span>
                                    </div>

                                    <!-- DESCRIPCION DEL EVENTO -->
                                    <div>
                                        <strong>Descripción del evento</strong><br/>
                                        <div style="border: 1px solid #ffcccc; padding: 2mm; height: 15mm; overflow: hidden; background: #fff5f5;">
                                            <span t-field="o.security_situation_id.details_whats"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- INFORMACIÓN DEL EMPLEADO (SI APLICA) -->
                            <t t-if="o.security_situation_id.employee_id">
                                <div style="margin-bottom: 3mm; border-top: 1px solid #e67e22; padding-top: 2mm;">
                                    <div style="background: #e67e22; color: white; padding: 1mm 2mm; font-size: 10pt; margin-bottom: 1mm;">
                                        <strong>INFORMACIÓN DEL EMPLEADO INVOLUCRADO</strong>
                                    </div>

                                    <!-- DATOS EMPLEADO EN GRID -->
                                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1mm; margin-bottom: 1mm;">
                                        <div>
                                            <strong>Nombre:</strong><br/>
                                            <span t-field="o.security_situation_id.employee_id.name"/>
                                        </div>
                                        <div>
                                            <strong>Estado Laboral:</strong><br/>
                                            <span t-field="o.security_situation_id.actual_laboral_state"/>
                                        </div>
                                        <div>
                                            <strong>Puesto:</strong><br/>
                                            <span t-field="o.security_situation_id.job_id.name"/>
                                        </div>
                                        <div>
                                            <strong>Departamento:</strong><br/>
                                            <span t-field="o.security_situation_id.department_id.name"/>
                                        </div>
                                    </div>

                                    <!-- DATOS ADICIONALES EMPLEADO -->
                                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1mm;">
                                        <t t-if="o.security_situation_id.actual_laboral_state != 'normal'">
                                            <div>
                                                <strong>Días de Incapacidad:</strong><br/>
                                                <span t-field="o.security_situation_id.given_days"/>
                                            </div>
                                        </t>
                                        <div>
                                            <strong>Atención Médica:</strong><br/>
                                            <span t-field="o.security_situation_id.attention_type"/>
                                        </div>
                                        <div>
                                            <strong>Líder Directo:</strong><br/>
                                            <span t-field="o.security_situation_id.parent_id.name"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- INFORMACIÓN DE LESIONES (SI APLICA) -->
                            <t t-if="o.security_situation_id.employee_id and o.security_situation_id.is_injuried == 'yes'">
                                <div style="margin-bottom: 3mm; border-top: 1px solid #c0392b; padding-top: 2mm;">
                                    <div style="background: #c0392b; color: white; padding: 1mm 2mm; font-size: 10pt; margin-bottom: 1mm;">
                                        <strong>INFORMACIÓN DE LESIONES</strong>
                                    </div>

                                    <!-- DATOS LESIONES EN GRID -->
                                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1mm; margin-bottom: 1mm;">
                                        <div>
                                            <strong>Tipo de Lesión:</strong><br/>
                                            <span t-field="o.security_situation_id.injury_type_id.name"/>
                                        </div>
                                        <div>
                                            <strong>Severidad:</strong><br/>
                                            <span t-field="o.security_situation_id.injury_severity"/>
                                        </div>
                                        <div>
                                            <strong>Partes Afectadas:</strong><br/>
                                            <span t-field="o.security_situation_id.injured_body_part"/>
                                        </div>
                                    </div>

                                    <!-- DESCRIPCIÓN LESION -->
                                    <div>
                                        <strong>Factor Tipo:</strong><br/>
                                        <span t-field="o.security_situation_id.factor_type"/>
                                    </div>
                                    <div style="margin-top: 1mm;">
                                        <strong>Descripción de la Lesión:</strong><br/>
                                        <div style="border: 1px solid #ffcccc; padding: 2mm; height: 15mm; overflow: hidden; background: #fff5f5;">
                                            <span t-field="o.security_situation_id.injury_description"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- ESPACIO PARA FIRMAS -->
                            <div style="margin-top: 5mm; padding-top: 2mm; border-top: 1px dashed #ccc;">
                                <table class="table table-sm table-borderless" style="width: 100%; font-size: 10pt;">
                                    <tr>
                                        <td style="width: 50%; text-align: center;">
                                             <br/>
                                             <br/>
                                             <br/>
                                             <br/>
                                             <br/>
                                            ___________________________<br/>
                                            <strong>Supervisor SSMA</strong><br/>
                                            <span t-field="o.security_situation_id.supervisor_ssma"/>
                                        </td>
                                        <t t-if="o.security_situation_id.is_constr_supervisor == 'yes'">
                                            <td style="width: 50%; text-align: center;">
                                             <br/>
                                             <br/>
                                             <br/>
                                             <br/>
                                             <br/>
                                            ___________________________<br/>
                                            <strong>Responsable de obra</strong><br/>
                                            <span t-field="o.security_situation_id.constr_supervisor"/>
                                        </td>
                                        </t>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>